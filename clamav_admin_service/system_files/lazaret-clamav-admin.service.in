[Unit]
Description=Lazaret ClamAV admin service
Requires=lazaret-settings-merge.service
After=lazaret-settings-merge.service

[Service]
Type=dbus
BusName=page.codeberg.wvhulle.Lazaret.ClamavAdmin
ExecStart=@ADMIN_SERVICE_PATH@ serve
StateDirectory=lazaret
RuntimeDirectory=lazaret
RuntimeDirectoryPreserve=yes
ReadWritePaths=/var/lib/lazaret /run/lazaret -/var/lib/clamav
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0022

[Unit]
Description=Merge runtime changes into the clamd configuration
Before=clamav-daemon.service clamav-clamonacc.service
PartOf=clamav-daemon.service

[Service]
Type=oneshot
RemainAfterExit=yes
StateDirectory=lazaret
RuntimeDirectory=lazaret
RuntimeDirectoryPreserve=yes
ExecStart=@ADMIN_SERVICE_PATH@ merge
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0022
